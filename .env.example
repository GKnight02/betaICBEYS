# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

# Postgres de Neon (Vercel > Storage > Neon la añade sola en producción)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis para el límite de intentos (Vercel > Storage > Upstash).
# Si faltan, se usa un límite en memoria (válido solo para desarrollo local).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# La integración de Vercel puede crear estos nombres en su lugar; también sirven:
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Nombres de usuario (separados por comas) que tendrán rol admin
ADMIN_USERNAMES=""

# Zona horaria por defecto si el navegador no la envía
APP_TIMEZONE="America/Lima"